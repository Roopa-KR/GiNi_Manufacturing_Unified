# frontend app (Vite). Only VITE_* values reach the browser bundle - never put secrets here.
VITE_API_BASE_URL=/api
VITE_APP_KIND=operator
VITE_POLL_INTERVAL_MS=5000
# the synthetic-demo stripe; the fresh factory shows its own environment banner from /api/environment regardless of this flag
VITE_SHOW_SYNTHETIC_BANNER=true
# Local proxy target (non-secret, not included in browser code). Change it if the API runs on another port.
DEV_API_PROXY_TARGET=http://localhost:5000
