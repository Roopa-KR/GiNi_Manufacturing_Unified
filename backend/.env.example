# GiNi API (Express). Copy to backend/.env for local runs. NEVER commit real values; the placeholders below are not secrets.
# Both services (this API and backend/python_engine) MUST point to the same MONGODB_URI + MONGODB_DB_NAME + GINI_ENVIRONMENT + DATASET_ID.
# /api/ready reports a mismatch between the two .env files without printing any value.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
EXTRA_ALLOWED_ORIGINS=

# ---- database -------------------------------------------------------------------------------------------------------
# MONGODB_DB_NAME always decides the database (a database name inside MONGODB_URI is ignored).
# Fresh Factory: use a NEW, empty database name. The synthetic demonstration keeps its own database (e.g. gini_demo_dev).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=gini_unified_teamtest
MONGODB_MAX_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ---- environment ----------------------------------------------------------------------------------------------------
# FRESH_FACTORY  = empty factory for team testing (no workbook import, no seeded workers or history)
# SYNTHETIC_DEMO = the imported synthetic demonstration (requires its seeded database and DATASET_ID=GINI-SYN-TANKS)
GINI_ENVIRONMENT=FRESH_FACTORY
DATASET_ID=GINI-FRESH-FACTORY
ENVIRONMENT_NAME="Fresh factory - team test"
# guarded reset of the test factory's operational data: false by default, always refused when NODE_ENV=production
ALLOW_FACTORY_RESET=false

SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
DEMO_MODE=true

# ---- bootstrap admin (read only by `npm run factory:init` / seed tools, never by the running API) ---------------------
# Leave ADMIN_PASSWORD empty to type it at the prompt (recommended): it is stored only as a scrypt hash. There is no default.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# synthetic demo only: seed for the derived demo PINs (backend/seed/setup_accounts.py)
DEMO_PIN_SEED=

# ---- photo evidence -------------------------------------------------------------------------------------------------
EVIDENCE_STORAGE_MODE=local
EVIDENCE_LOCAL_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_FILES=10
UPLOAD_MAX_MEGAPIXELS=40

# ---- e-mail: capture = rendered and stored, never sent (use it for testing) ----------------------------------------------
EMAIL_MODE=capture
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=GiNi Team Test <no-reply@example.com>
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=15000
# smtp mode sends ONLY to addresses on this allowlist (comma separated)
ALERT_EMAIL_ALLOWLIST=
ALERT_EMAIL_RECIPIENTS=
EMAIL_COOLDOWN_SECONDS=900

# server-to-server secret shared with backend/python_engine/.env
INTERNAL_SERVICE_TOKEN=GENERATE_A_SEPARATE_RANDOM_SECRET
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MIN=15
