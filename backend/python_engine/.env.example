# Python engine worker. Copy to backend/python_engine/.env for local runs; never commit real values.
# MUST match backend/.env: MONGODB_URI, MONGODB_DB_NAME, GINI_ENVIRONMENT, DATASET_ID and INTERNAL_SERVICE_TOKEN.
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=gini_unified_teamtest
GINI_ENVIRONMENT=FRESH_FACTORY
DATASET_ID=GINI-FRESH-FACTORY
NODE_API_INTERNAL_URL=http://localhost:5000
INTERNAL_SERVICE_TOKEN=SAME_SERVER_TO_SERVER_SECRET_AS_API
ENGINE_TICK_SECONDS=5
ENGINE_JOB_LEASE_SECONDS=60
ENGINE_MAX_RETRIES=5
SNAPSHOT_INTERVAL_SECONDS=300
SIMULATION_SEED=42
# synthetic demo default only; a fresh factory uses the timezone saved in Admin > Factory setup
DEFAULT_PLANT_TIMEZONE=America/Bogota
DEFAULT_SIMULATION_MODE=interactive
SAFETY_BUFFER_MINUTES=10
